@model PocketFlow.ViewModels.History.HistoryListViewModel
@{
    ViewData["Title"] = "Historial";
}

<div class="container-fluid py-4 max-w-1200">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-primary">Historial</h2>
            <p class="text-muted mb-0">Tus meses anteriores en modo solo lectura.</p>
        </div>
    </div>

    @if (!Model.Plans.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted mb-3 d-block"></i>
            <h4 class="text-muted">Aún no hay historial</h4>
            <p class="text-muted">Tus meses aparecerán aquí a medida que los vayas cerrando.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var plan in Model.Plans)
            {
                <div class="col">
                    <a asp-action="Detail" asp-route-planId="@plan.Id" class="text-decoration-none">
                        <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition-all @(plan.IsActive ? "bg-primary-subtle" : "bg-white")">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4 class="fw-bold mb-0 text-dark">@plan.MonthName @plan.Year</h4>
                                    @if (plan.IsActive)
                                    {
                                        <span class="badge bg-primary rounded-pill">Mes Actual</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">Cerrado</span>
                                    }
                                </div>
                                
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Total gastado</span>
                                    <span class="fw-bold text-dark">@plan.TotalSpent.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Sobrante</span>
                                    <span class="fw-bold @(plan.FinalBalance >= 0 ? "text-success" : "text-danger")">
                                        @plan.FinalBalance.ToString("C")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        }
        .transition-all {
            transition: all 0.3s ease;
        }
    </style>
}
