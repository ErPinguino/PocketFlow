@using System.Globalization
@model PocketFlow.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AppLayout";
    
    var culture = Model.Currency == "EUR" ? new CultureInfo("es-ES") : new CultureInfo("en-US");
    
    string GetStatusClass(PocketFlow.Models.MonthlyStatus status) => status switch
    {
        PocketFlow.Models.MonthlyStatus.Healthy => "status-healthy",
        PocketFlow.Models.MonthlyStatus.OverBudget => "status-danger",
        _ => "status-warning"
    };

    string GetStatusIcon(PocketFlow.Models.MonthlyStatus status) => status switch
    {
        PocketFlow.Models.MonthlyStatus.Healthy => "bi-check-circle-fill",
        PocketFlow.Models.MonthlyStatus.OverBudget => "bi-exclamation-triangle-fill",
        _ => "bi-exclamation-circle-fill"
    };
    
    int GetProgress(decimal spent, decimal initial)
    {
        if (initial <= 0) return spent > 0 ? 100 : 0;
        var p = (int)((spent / initial) * 100);
        return p > 100 ? 100 : p;
    }
}

<div class="container py-4 px-3 px-md-4">
    <!-- 1. Cabecera -->
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h1 class="h3 fw-bold mb-1">¡Hola, @Model.UserName!</h1>
            <p class="text-muted mb-0">@Model.AccountName &bull; <span class="text-capitalize">@Model.Month @Model.Year</span></p>
        </div>
    </div>

    @if (Model.ShouldAskPaydayConfirmation)
    {
        <!-- Aviso de Cobro -->
        <div class="card bg-primary text-white shadow mb-4 border-0 rounded-4" id="paydayCard">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
                <div class="mb-3 mb-md-0 d-flex align-items-center">
                    <i class="bi bi-wallet2 display-6 me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-1">¿Has cobrado ya?</h4>
                        <p class="mb-0 text-white-50">Parece que ha llegado el momento de cerrar este mes y empezar uno nuevo.</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-light rounded-pill px-4" onclick="document.getElementById('paydayCard').style.display='none'">
                        Todavía no
                    </button>
                    <a asp-controller="MonthlyTransition" asp-action="Start" class="btn btn-light text-primary fw-bold rounded-pill px-4">
                        Sí, he cobrado
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- 5. Estado del mes -->
    <div id="monthlyStatusContainer" class="mb-4 @GetStatusClass(Model.MonthlyStatus)">
        <i id="monthlyStatusIcon" class="bi @GetStatusIcon(Model.MonthlyStatus) me-2"></i>
        <strong id="monthlyStatusMessage">@Model.StatusMessage</strong>
    </div>

    <!-- 2. Tarjeta Principal (Bolsillo Libre) -->
    <div class="card dashboard-card gsap-card shadow-sm mb-4 border-0">
        <div class="card-body p-4 text-center">
            <h5 class="text-muted small fw-bold text-uppercase mb-2">Disponible</h5>
            <h2 id="freePocketRemaining" class="display-3 fw-bold @(Model.FreePocketRemaining < 0 ? "text-danger" : "text-success") mb-3 money-value">
                @Model.FreePocketRemaining.ToString("C", culture)
            </h2>
            
            <div class="d-flex justify-content-between text-muted small mb-2 px-md-3">
                <span id="freePocketSpent">Gastado: @Model.FreePocketSpent.ToString("C", culture)</span>
                <span id="freePocketInitial">de @Model.FreePocketInitial.ToString("C", culture)</span>
            </div>
            
            @if (Model.FreePocketSpent == 0)
            {
                <div class="alert alert-light border-soft mt-3 mb-0 text-center small text-muted">
                    <i class="bi bi-info-circle me-1"></i> Todavía no has registrado ningún gasto este mes.
                </div>
            }
            else
            {
                <div class="progress progress-slim mt-1">
                    <div id="freePocketProgress" class="progress-bar @(Model.FreePocketRemaining < 0 ? "bg-danger" : "bg-primary")" 
                         role="progressbar" 
                         style="width: @GetProgress(Model.FreePocketSpent, Model.FreePocketInitial)%"></div>
                </div>
            }
        </div>
    </div>

    <!-- 3. Tarjeta Semanal -->
    <div class="card dashboard-card gsap-card shadow-sm mb-4 border-0">
        <div class="card-body p-4 text-center">
            <h6 class="text-muted fw-bold text-uppercase mb-2">Esta semana</h6>
            <h3 id="weeklyRemainingBadge" class="fw-bold @(Model.WeeklyRemaining < 0 ? "text-danger" : "text-primary") mb-2 money-value">
                @Model.WeeklyRemaining.ToString("C", culture)
            </h3>
            
            @if (Model.WeeklyRemaining < 0)
            {
                <p class="text-danger small fw-bold mb-3"><i class="bi bi-exclamation-circle me-1"></i> Has gastado @(Math.Abs(Model.WeeklyRemaining).ToString("C", culture)) más de tu presupuesto semanal.</p>
            }
            else
            {
                <p class="text-muted small mb-3">Te quedan @Model.WeeklyRemaining.ToString("C", culture) para gastar</p>
            }

            <div class="d-flex justify-content-between text-muted small mb-2 px-md-3">
                <span id="weeklySpent">Gastado: @Model.WeeklySpent.ToString("C", culture)</span>
                <span id="weeklyInitial">de @Model.WeeklyBudget.ToString("C", culture)</span>
            </div>
            <div class="progress progress-slim mt-1">
                <div id="weeklyProgress" class="progress-bar @(Model.WeeklyRemaining < 0 ? "bg-danger" : "bg-primary")" 
                     role="progressbar" 
                     style="width: @GetProgress(Model.WeeklySpent, Model.WeeklyBudget)%"></div>
            </div>
        </div>
    </div>

    <!-- 4. Vida y Caprichos -->
    <div class="row g-3 mb-4 gsap-card">
        <div class="col-6">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-2"><i class="bi bi-cart me-1"></i> Vida</div>
                    <h5 id="lifeRemaining" class="fw-bold @(Model.LifeRemaining < 0 ? "text-danger" : "text-dark") mb-1 money-value">@Model.LifeRemaining.ToString("C", culture)</h5>
                    <div class="small text-muted mb-3">Disponible</div>
                    
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                        <span id="lifeSpent">Gastado: @Model.LifeSpent.ToString("C", culture)</span>
                    </div>
                    <div class="progress mt-2 progress-slim">
                        <div id="lifeProgress" class="progress-bar @(Model.LifeRemaining < 0 ? "bg-danger" : "bg-info")" 
                             style="width: @GetProgress(Model.LifeSpent, Model.LifeBudget)%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-2"><i class="bi bi-controller me-1"></i> Caprichos</div>
                    <h5 id="whimRemaining" class="fw-bold @(Model.WhimRemaining < 0 ? "text-danger" : "text-dark") mb-1 money-value">@Model.WhimRemaining.ToString("C", culture)</h5>
                    <div class="small text-muted mb-3">Disponible</div>
                    
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                        <span id="whimSpent">Gastado: @Model.WhimSpent.ToString("C", culture)</span>
                    </div>
                    <div class="progress mt-2 progress-slim">
                        <div id="whimProgress" class="progress-bar @(Model.WhimRemaining < 0 ? "bg-danger" : "bg-warning")" 
                             style="width: @GetProgress(Model.WhimSpent, Model.WhimBudget)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Huchas -->
    <h5 class="fw-bold mb-3 mt-5">Tus Huchas</h5>
    @if (!Model.PiggyBanks.Any())
    {
        <div class="alert alert-light border-soft text-center py-4 mb-4">
            <i class="bi bi-piggy-bank text-muted display-4 d-block mb-3"></i>
            <h6 class="fw-bold text-muted">No tienes ninguna hucha</h6>
            <p class="text-muted small mb-0">Las huchas te ayudan a ahorrar mensualmente para un objetivo concreto.</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-5">
            @foreach (var pb in Model.PiggyBanks)
            {
                var isCompleted = pb.CurrentAmount >= pb.TargetAmount;
                var remainingAmount = Math.Max(0, pb.TargetAmount - pb.CurrentAmount);
                
                <div class="col-12 col-md-6 gsap-card">
                    <div class="card dashboard-card shadow-sm border-0 h-100">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 fs-3 text-primary">@pb.Icon</div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@pb.Name</h6>
                                    @if (isCompleted)
                                    {
                                        <small class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> ¡Objetivo alcanzado!</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Faltan @remainingAmount.ToString("C", culture)</small>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <span class="money-value fw-bold text-dark">@pb.CurrentAmount.ToString("C", culture)</span>
                                <span>de @pb.TargetAmount.ToString("C", culture)</span>
                            </div>
                            <div class="progress progress-slim">
                                <div class="progress-bar @(isCompleted ? "bg-success" : "bg-primary")" 
                                     role="progressbar" 
                                     style="width: @pb.ProgressPercentage%"></div>
                            </div>
                            <div class="text-end mt-2">
                                <small class="text-muted">+@pb.MonthlyContribution.ToString("C", culture)/mes</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function formatCurrency(amount) {
            // Usa el locale y currency del modelo
            return new Intl.NumberFormat('@(Model.Currency == "EUR" ? "es-ES" : "en-US")', {
                style: 'currency',
                currency: '@Model.Currency'
            }).format(amount);
        }

        function getStatusClass(status) {
            switch(status) {
                case 0: return "status-healthy";
                case 1: return "status-danger";
                default: return "status-warning";
            }
        }

        function getStatusIcon(status) {
            switch(status) {
                case 0: return "bi-check-circle-fill";
                case 1: return "bi-exclamation-triangle-fill";
                default: return "bi-exclamation-circle-fill";
            }
        }

        function getProgress(spent, initial) {
            if (initial <= 0) return spent > 0 ? 100 : 0;
            let p = Math.floor((spent / initial) * 100);
            return p > 100 ? 100 : p;
        }

        function updateDashboardUI(summary, warnings) {
            // Estado
            const monthlyStatusContainer = document.getElementById('monthlyStatusContainer');
            if (monthlyStatusContainer) monthlyStatusContainer.className = "mb-4 " + getStatusClass(summary.monthlyStatus);
            
            const monthlyStatusIcon = document.getElementById('monthlyStatusIcon');
            if (monthlyStatusIcon) monthlyStatusIcon.className = "bi " + getStatusIcon(summary.monthlyStatus) + " me-2";
            
            const monthlyStatusMessage = document.getElementById('monthlyStatusMessage');
            if (monthlyStatusMessage) monthlyStatusMessage.textContent = summary.statusMessage;

            // Bolsillo Libre
            const fpRemaining = document.getElementById('freePocketRemaining');
            if (fpRemaining) {
                fpRemaining.textContent = formatCurrency(summary.freePocketRemaining);
                fpRemaining.className = "display-3 fw-bold mb-3 money-value " + (summary.freePocketRemaining < 0 ? "text-danger" : "text-success");
            }
            
            const fpInitial = document.getElementById('freePocketInitial');
            if (fpInitial) fpInitial.textContent = "de " + formatCurrency(summary.freePocketInitial);
            
            const fpSpent = document.getElementById('freePocketSpent');
            if (fpSpent) fpSpent.textContent = "Gastado: " + formatCurrency(summary.freePocketSpent);
            
            const fpProgress = document.getElementById('freePocketProgress');
            if (fpProgress) {
                fpProgress.className = "progress-bar " + (summary.freePocketRemaining < 0 ? "bg-danger" : "bg-primary");
                fpProgress.style.width = getProgress(summary.freePocketSpent, summary.freePocketInitial) + "%";
            }

            // Semanal
            const wkBadge = document.getElementById('weeklyRemainingBadge');
            if (wkBadge) {
                wkBadge.textContent = formatCurrency(summary.weeklyRemaining);
                wkBadge.className = "fw-bold mb-2 money-value " + (summary.weeklyRemaining < 0 ? "text-danger" : "text-primary");
            }
            
            const wkInitial = document.getElementById('weeklyInitial');
            if (wkInitial) wkInitial.textContent = "de " + formatCurrency(summary.weeklyBudget);
            
            const wkSpent = document.getElementById('weeklySpent');
            if (wkSpent) wkSpent.textContent = "Gastado: " + formatCurrency(summary.weeklySpent);
            
            const wkProgress = document.getElementById('weeklyProgress');
            if (wkProgress) {
                wkProgress.className = "progress-bar " + (summary.weeklyRemaining < 0 ? "bg-danger" : "bg-primary");
                wkProgress.style.width = getProgress(summary.weeklySpent, summary.weeklyBudget) + "%";
            }

            // Vida
            const lfRemaining = document.getElementById('lifeRemaining');
            if (lfRemaining) {
                lfRemaining.textContent = formatCurrency(summary.lifeRemaining);
                lfRemaining.className = "fw-bold mb-1 money-value " + (summary.lifeRemaining < 0 ? "text-danger" : "text-dark");
            }
            
            const lfInitial = document.getElementById('lifeInitial');
            if (lfInitial) lfInitial.textContent = "de " + formatCurrency(summary.lifeBudget);
            
            const lfSpent = document.getElementById('lifeSpent');
            if (lfSpent) lfSpent.textContent = "Gastado: " + formatCurrency(summary.lifeSpent);
            
            const lfProgress = document.getElementById('lifeProgress');
            if (lfProgress) {
                lfProgress.className = "progress-bar " + (summary.lifeRemaining < 0 ? "bg-danger" : "bg-info");
                lfProgress.style.width = getProgress(summary.lifeSpent, summary.lifeBudget) + "%";
            }

            // Caprichos
            const whRemaining = document.getElementById('whimRemaining');
            if (whRemaining) {
                whRemaining.textContent = formatCurrency(summary.whimRemaining);
                whRemaining.className = "fw-bold mb-1 money-value " + (summary.whimRemaining < 0 ? "text-danger" : "text-dark");
            }
            
            const whInitial = document.getElementById('whimInitial');
            if (whInitial) whInitial.textContent = "de " + formatCurrency(summary.whimBudget);
            
            const whSpent = document.getElementById('whimSpent');
            if (whSpent) whSpent.textContent = "Gastado: " + formatCurrency(summary.whimSpent);
            
            const whProgress = document.getElementById('whimProgress');
            if (whProgress) {
                whProgress.className = "progress-bar " + (summary.whimRemaining < 0 ? "bg-danger" : "bg-warning");
                whProgress.style.width = getProgress(summary.whimSpent, summary.whimBudget) + "%";
            }
            
            // Note: PiggyBanks aren't updated by expenses right now, so we skip them.
        }
    </script>
}
