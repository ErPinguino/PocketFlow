@using System.Globalization
@using PocketFlow.Models
@model PocketFlow.ViewModels.Pocket.PocketViewModel
@{
    ViewData["Title"] = "Bolsillo";
    Layout = "_AppLayout";
    var culture = Model.Currency == "EUR" ? new CultureInfo("es-ES") : new CultureInfo("en-US");
}

<div class="container py-4 px-3 px-md-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Tu Bolsillo</h1>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Disponible</div>
                    <h5 class="fw-bold @(Model.FreePocketRemaining < 0 ? "text-danger" : "text-success")">@Model.FreePocketRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Semanal</div>
                    <h5 class="fw-bold @(Model.WeeklyRemaining < 0 ? "text-danger" : "")">@Model.WeeklyRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Vida</div>
                    <h5 class="fw-bold @(Model.LifeRemaining < 0 ? "text-danger" : "")">@Model.LifeRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Caprichos</div>
                    <h5 class="fw-bold @(Model.WhimRemaining < 0 ? "text-danger" : "")">@Model.WhimRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index" asp-route-category="" class="btn @(Model.ActiveFilter == null ? "btn-primary" : "btn-outline-primary")">Todos</a>
            <a asp-action="Index" asp-route-category="@ExpenseCategory.Life" class="btn @(Model.ActiveFilter == ExpenseCategory.Life ? "btn-primary" : "btn-outline-primary")">Vida</a>
            <a asp-action="Index" asp-route-category="@ExpenseCategory.Whim" class="btn @(Model.ActiveFilter == ExpenseCategory.Whim ? "btn-primary" : "btn-outline-primary")">Caprichos</a>
        </div>
    </div>

    <!-- Expense List -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Expenses.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-receipt display-4 d-block mb-3"></i>
                    <p>No hay gastos registrados todavía.</p>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach(var item in Model.Expenses)
                    {
                        <li class="list-group-item p-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-3 text-center" style="width: 48px; height: 48px; line-height: 32px;">
                                    <i class="bi @item.IconClass fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@(string.IsNullOrWhiteSpace(item.Description) ? item.CategoryDisplayName : item.Description)</h6>
                                    <small class="text-muted">@item.DateDisplay &bull; @item.CategoryDisplayName</small>
                                </div>
                            </div>
                            <div class="fw-bold fs-5">
                                -@item.Amount.ToString("C", culture)
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Navegación de gastos">
              <ul class="pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                  <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-category="@Model.ActiveFilter">Anterior</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@Model.CurrentPage de @Model.TotalPages</span></li>
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                  <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-category="@Model.ActiveFilter">Siguiente</a>
                </li>
              </ul>
            </nav>
        </div>
    }
</div>
