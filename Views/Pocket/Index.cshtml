@using System.Globalization
@using PocketFlow.Models
@model PocketFlow.ViewModels.Pocket.PocketViewModel
@{
    ViewData["Title"] = "Bolsillo";
    Layout = "_AppLayout";
    var culture = Model.Currency == "EUR" ? new CultureInfo("es-ES") : new CultureInfo("en-US");
}

<div class="container py-4 px-3 px-md-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Tu Bolsillo</h1>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Disponible</div>
                    <h5 class="fw-bold @(Model.FreePocketRemaining < 0 ? "text-danger" : "text-success")">@Model.FreePocketRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Semanal</div>
                    <h5 class="fw-bold @(Model.WeeklyRemaining < 0 ? "text-danger" : "")">@Model.WeeklyRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Vida</div>
                    <h5 class="fw-bold @(Model.LifeRemaining < 0 ? "text-danger" : "")">@Model.LifeRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-card shadow-sm border-0 h-100">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Caprichos</div>
                    <h5 class="fw-bold @(Model.WhimRemaining < 0 ? "text-danger" : "")">@Model.WhimRemaining.ToString("C", culture)</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Installments -->
    @if (Model.Installments != null && Model.Installments.Any())
    {
        <div class="mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-calendar-range me-2 text-primary"></i> Pagos a Plazos Activos</h5>
            <div class="row g-3">
                @foreach (var inst in Model.Installments)
                {
                    <div class="col-12 col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-1">@inst.Description</h6>
                                        <span class="badge bg-light text-dark border"><i class="bi @(inst.Category == ExpenseCategory.Life ? "bi-cart3" : "bi-controller") me-1"></i> @(inst.Category == ExpenseCategory.Life ? "Vida" : "Capricho")</span>
                                        @if (!string.IsNullOrEmpty(inst.Provider))
                                        {
                                            <span class="badge bg-light text-muted border ms-1">@inst.Provider</span>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary rounded-pill px-2">@inst.PaidInstallmentsCount / @inst.InstallmentCount</span>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-end mt-3">
                                    <div>
                                        <div class="small text-muted mb-1">Cuota mensual</div>
                                        <div class="fw-bold fs-5">@inst.BaseInstallmentAmount.ToString("C", culture)</div>
                                    </div>
                                    <div>
                                        <div class="small text-muted mb-1 text-end">Pendiente</div>
                                        <div class="fw-bold text-end">@inst.PendingAmount.ToString("C", culture)</div>
                                    </div>
                                </div>
                                
                                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                    <div class="small text-muted">
                                        @if (inst.NextDueDate.HasValue)
                                        {
                                            <span>Próx. cuota: <strong class="text-dark">@inst.NextDueDate.Value.ToString("dd MMM", culture)</strong></span>
                                        }
                                    </div>
                                    <form asp-controller="Installments" asp-action="Liquidate" asp-route-id="@inst.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill fw-bold" onclick="return confirm('¿Seguro que deseas liquidar el importe pendiente de @inst.PendingAmount.ToString("C", culture)?');">
                                            Liquidar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filters, Search & Sort -->
    <div class="row g-3 align-items-center mb-4">
        <div class="col-12 col-md-auto d-flex justify-content-center">
            <div class="btn-group shadow-sm" role="group">
                <button type="button" class="btn btn-filter @(Model.ActiveFilter == null ? "btn-primary" : "btn-outline-primary")" data-category="">Todos</button>
                <button type="button" class="btn btn-filter @(Model.ActiveFilter == ExpenseCategory.Life ? "btn-primary" : "btn-outline-primary")" data-category="@ExpenseCategory.Life">Vida</button>
                <button type="button" class="btn btn-filter @(Model.ActiveFilter == ExpenseCategory.Whim ? "btn-primary" : "btn-outline-primary")" data-category="@ExpenseCategory.Whim">Caprichos</button>
            </div>
        </div>
        
        <div class="col-12 col-md position-relative">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text" id="expenseSearch" class="form-control form-control-lg ps-5 bg-white border-0 shadow-sm" placeholder="Buscar gastos..." value="@ViewData["Search"]">
        </div>
        
        <div class="col-12 col-md-auto">
            <select id="expenseSort" class="form-select form-select-lg border-0 shadow-sm bg-white" style="min-width: 180px;">
                <option value="newest" selected="@(ViewData["Sort"]?.ToString() == "newest" || ViewData["Sort"] == null)">Más recientes</option>
                <option value="oldest" selected="@(ViewData["Sort"]?.ToString() == "oldest")">Más antiguos</option>
                <option value="highest" selected="@(ViewData["Sort"]?.ToString() == "highest")">Mayor importe</option>
                <option value="lowest" selected="@(ViewData["Sort"]?.ToString() == "lowest")">Menor importe</option>
            </select>
        </div>
    </div>

    <!-- Expense List -->
    <div class="pocket-list-card mb-4">
        <div class="card-body p-0" id="expenseListContainer">
            <partial name="_ExpenseList" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pocket.js" asp-append-version="true"></script>
}

