@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_AuthLayout";
}

<h4 class="text-center mb-4">Crear cuenta</h4>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nombre</label>
        <input asp-for="Name" class="form-control" placeholder="Tu nombre" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Correo electrónico</label>
        <input asp-for="Email" class="form-control" type="email" placeholder="ejemplo@correo.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Contraseña</label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="AcceptTerms" class="form-check-input" />
        <label asp-for="AcceptTerms" class="form-check-label small">Acepto los términos y condiciones</label>
        <br/><span asp-validation-for="AcceptTerms" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">Crear cuenta</button>

    <div class="d-flex align-items-center mb-3">
        <hr class="flex-grow-1 border-secondary opacity-25">
        <span class="mx-3 text-muted small">o</span>
        <hr class="flex-grow-1 border-secondary opacity-25">
    </div>

    <a asp-controller="Account" asp-action="GoogleLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" class="btn btn-outline-dark w-100 mb-4 d-flex align-items-center justify-content-center bg-white text-dark" style="gap: 10px;">
        <img src="~/images/google-icon.svg" alt="Google" width="20" height="20" />
        <span class="fw-bold">Continuar con Google</span>
    </a>

    <div class="text-center">
        <a asp-action="Login" class="text-decoration-none text-muted small">¿Ya tienes cuenta? Iniciar sesión</a>
    </div>
</form>
