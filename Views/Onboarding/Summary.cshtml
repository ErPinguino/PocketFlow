@model PocketFlow.ViewModels.Onboarding.OnboardingSummaryViewModel
@{
    ViewData["Title"] = "Resumen de tu plan";
    ViewData["Step"] = 6;
    Layout = "_OnboardingLayout";
}

<h4 class="mb-4">Resumen y confirmación</h4>
<p class="text-muted">Revisa que todo esté correcto antes de crear tu plan financiero.</p>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title text-primary">Detalles de la cuenta</h5>
        <ul class="list-unstyled">
            <li><strong>Cuenta:</strong> @Model.AccountName</li>
            <li><strong>Ingresos:</strong> @Model.MonthlyIncome.ToString("C") (@Model.Currency)</li>
            <li><strong>Día de cobro:</strong> @Model.Payday</li>
            <li><strong>Gastos Fijos:</strong> <span class="text-danger">@Model.FixedExpenses.ToString("C")</span></li>
        </ul>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title text-primary">Tus Huchas (Ahorro)</h5>
        @if (!Model.PiggyBanks.Any())
        {
            <p class="text-muted small">No has configurado huchas.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var pb in Model.PiggyBanks)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <div>
                            @pb.Icon <strong>@pb.Name</strong>
                            <div class="small text-muted">Aportación: @((pb.MonthlyContribution ?? 0).ToString("C"))</div>
                        </div>
                        <div>
                            @if (pb.TargetAmount.HasValue)
                            {
                                <span class="badge bg-light text-dark border">Objetivo: @pb.TargetAmount.Value.ToString("C")</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Sin límite</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="card border-0 shadow-sm bg-light mb-4">
    <div class="card-body text-center">
        <h5 class="card-title text-success">Tu Bolsillo Libre</h5>
        <h3 class="display-6 fw-bold">@Model.AvailableFreePocket.ToString("C")</h3>
        
        <div class="row mt-4">
            <div class="col-6 border-end">
                <div class="small text-muted">Vida</div>
                <div class="fw-bold fs-5">@Model.LifeBudget.ToString("C")</div>
            </div>
            <div class="col-6">
                <div class="small text-muted">Caprichos</div>
                <div class="fw-bold fs-5">@Model.WhimBudget.ToString("C")</div>
            </div>
        </div>

        <hr />
        <p class="mb-0 text-muted">Presupuesto semanal orientativo:</p>
        <h4 class="text-primary mt-1">@Model.WeeklyBudget.ToString("C") / semana</h4>
    </div>
</div>

<div class="d-flex justify-content-between mt-4">
    <a asp-action="Pocket" class="btn btn-outline-secondary">Volver a editar</a>
    
    <form asp-action="Complete" method="post" class="d-inline">
        <button type="submit" class="btn btn-primary px-4">¡Crear mi plan!</button>
    </form>
</div>
