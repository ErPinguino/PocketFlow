@model PocketFlow.ViewModels.Onboarding.OnboardingAccountViewModel
@{
    ViewData["Title"] = "Tus ingresos";
    ViewData["Step"] = 2;
    Layout = "_OnboardingLayout";
}

<h4 class="mb-4">Tus ingresos mensuales</h4>

<form asp-action="Account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="AccountName" class="form-label">Nombre de la cuenta principal</label>
        <input asp-for="AccountName" class="form-control" />
        <span asp-validation-for="AccountName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Currency" class="form-label">Moneda</label>
        <select asp-for="Currency" class="form-select">
            <option value="EUR">EUR (€)</option>
            <option value="USD">USD ($)</option>
        </select>
        <span asp-validation-for="Currency" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MonthlyIncome" class="form-label">Ingresos fijos netos</label>
        <div class="input-group">
            <input asp-for="MonthlyIncome" class="form-control" type="number" step="0.01" />
            <span class="input-group-text">€</span>
        </div>
        <span asp-validation-for="MonthlyIncome" class="text-danger small"></span>
        <div class="form-text">Si tus ingresos varían, pon la estimación más baja o segura.</div>
    </div>

    <div class="mb-4">
        <label asp-for="Payday" class="form-label">Día de cobro habitual</label>
        <input asp-for="Payday" class="form-control" type="number" min="1" max="31" />
        <span asp-validation-for="Payday" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="Welcome" class="btn btn-outline-secondary">Atrás</a>
        <button type="submit" class="btn btn-primary px-4">Continuar</button>
    </div>
</form>
