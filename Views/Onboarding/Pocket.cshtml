@model PocketFlow.ViewModels.Onboarding.OnboardingPocketViewModel
@{
    ViewData["Title"] = "Tu Bolsillo";
    ViewData["Step"] = 5;
    Layout = "_OnboardingLayout";
}

<h4 class="mb-4">Tu Bolsillo Libre</h4>
<p class="text-muted">El dinero que te sobra después de pagar tus gastos fijos y apartar tus ahorros (huchas) es tu <strong>Bolsillo Libre</strong>. Divídelo entre <strong>Vida</strong> (comida, transporte) y <strong>Caprichos</strong> (ocio, extras).</p>

<div class="card bg-light border-0 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
            <span>Ingresos:</span>
            <span class="fw-bold">@Model.MonthlyIncome.ToString("C")</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span>Gastos fijos:</span>
            <span class="text-danger fw-bold">- @Model.FixedExpenses.ToString("C")</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span>Ahorro (Huchas):</span>
            <span class="text-primary fw-bold">- @Model.TotalMonthlySavings.ToString("C")</span>
        </div>
        <hr />
        <div class="d-flex justify-content-between">
            <span class="fw-bold">Bolsillo Libre Disponible:</span>
            <span class="fw-bold fs-5 text-success">@Model.AvailableFreePocket.ToString("C")</span>
        </div>
    </div>
</div>

<form asp-action="Pocket" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="LifeBudget" class="form-label">Vida (comida, transporte...)</label>
            <div class="input-group">
                <input asp-for="LifeBudget" class="form-control" type="number" step="0.01" />
                <span class="input-group-text">€</span>
            </div>
            <span asp-validation-for="LifeBudget" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="WhimBudget" class="form-label">Caprichos (ocio, salidas...)</label>
            <div class="input-group">
                <input asp-for="WhimBudget" class="form-control" type="number" step="0.01" />
                <span class="input-group-text">€</span>
            </div>
            <span asp-validation-for="WhimBudget" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a asp-action="PiggyBanks" class="btn btn-outline-secondary">Atrás</a>
        <button type="submit" class="btn btn-primary px-4">Continuar</button>
    </div>
</form>
