@model PocketFlow.ViewModels.Onboarding.OnboardingFixedExpensesViewModel
@{
    ViewData["Title"] = "Gastos fijos";
    ViewData["Step"] = 3;
    Layout = "_OnboardingLayout";
}

<h4 class="mb-4">Tus gastos fijos</h4>
<p class="text-muted">Incluye aquí todos los gastos que pagas obligatoriamente cada mes (alquiler, hipoteca, luz, agua, internet, suscripciones).</p>

<form asp-action="FixedExpenses" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-4">
        <label asp-for="FixedExpenses" class="form-label">Total de gastos fijos mensuales</label>
        <div class="input-group">
            <input asp-for="FixedExpenses" class="form-control" type="number" step="0.01" />
            <span class="input-group-text">€</span>
        </div>
        <span asp-validation-for="FixedExpenses" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="Account" class="btn btn-outline-secondary">Atrás</a>
        <button type="submit" class="btn btn-primary px-4">Continuar</button>
    </div>
</form>
