<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PocketFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light pb-5 pb-md-0">
    <div class="d-flex flex-column flex-md-row min-vh-100">
        <!-- Sidebar para Escritorio -->
        <nav class="sidebar bg-white border-end d-none d-md-flex flex-column p-3">
            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <span class="fs-4 fw-bold text-primary">PocketFlow</span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link active bg-light text-primary fw-bold">
                        <i class="bi bi-house-door-fill me-2"></i> Inicio
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-link link-dark">
                        <i class="bi bi-wallet2 me-2"></i> Bolsillo
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-link link-dark">
                        <i class="bi bi-piggy-bank me-2"></i> Huchas
                    </a>
                </li>
            </ul>
            <hr>
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle" id="dropdownUser2" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle fs-4 me-2"></i>
                    <strong>Perfil</strong>
                </a>
                <ul class="dropdown-menu text-small shadow" aria-labelledby="dropdownUser2">
                    <li><a class="dropdown-item" href="#">Ajustes</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">Cerrar sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Barra inferior para Móvil -->
        <nav class="mobile-nav bg-white border-top d-md-none fixed-bottom shadow-sm">
            <div class="d-flex justify-content-around p-2">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-center text-primary fw-bold">
                    <i class="bi bi-house-door-fill fs-4 d-block"></i>
                    <span class="small">Inicio</span>
                </a>
                <a href="#" class="nav-link text-center link-dark">
                    <i class="bi bi-wallet2 fs-4 d-block"></i>
                    <span class="small">Bolsillo</span>
                </a>
                <a href="#" class="nav-link text-center link-dark">
                    <i class="bi bi-piggy-bank fs-4 d-block"></i>
                    <span class="small">Huchas</span>
                </a>
                <a href="#" class="nav-link text-center link-dark" data-bs-toggle="modal" data-bs-target="#profileModal">
                    <i class="bi bi-person fs-4 d-block"></i>
                    <span class="small">Perfil</span>
                </a>
            </div>
        </nav>

        <!-- Modal Perfil Móvil -->
        <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
              <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body text-center">
                <i class="bi bi-person-circle display-4 text-secondary mb-3"></i>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-4">
                    <button type="submit" class="btn btn-outline-danger w-100">Cerrar sesión</button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenido Principal -->
        <main class="flex-grow-1 bg-light main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Botón flotante -->
    <button class="fab btn btn-primary shadow-lg rounded-circle" data-bs-toggle="modal" data-bs-target="#expenseModal" aria-label="Registrar gasto">
        <i class="bi bi-plus-lg fs-4"></i>
    </button>

    <!-- Modal Registro Gasto (Sprint 4) -->
    <div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered align-items-end align-items-md-center m-0 m-md-auto" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg rounded-top-4 rounded-md-3">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold">Registrar Gasto</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body pt-3">
            <div id="expenseModalAlert" class="alert alert-danger d-none" role="alert"></div>
            
            <form id="expenseForm" asp-controller="Expenses" asp-action="Create" method="post">
                <div class="mb-4 text-center">
                    <label for="expenseAmount" class="form-label text-muted small fw-bold mb-1">IMPORTE</label>
                    <div class="input-group input-group-lg justify-content-center border-bottom border-2 border-primary pb-2 w-75 mx-auto">
                        <input type="number" min="0.01" step="0.01" class="form-control form-control-plaintext text-center fs-1 fw-bold text-dark p-0" id="expenseAmount" name="Amount" placeholder="0.00" autocomplete="off" required>
                        <span class="input-group-text bg-transparent border-0 fs-3 text-muted p-0 ms-1">€</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold mb-2 d-block">CATEGORÍA</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Category" id="catLife" value="Life" required>
                            <label class="btn btn-outline-primary w-100 py-3 rounded-4" for="catLife">
                                <i class="bi bi-cart3 fs-4 d-block mb-1"></i>
                                <span class="fw-bold">Vida</span>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Category" id="catWhim" value="Whim">
                            <label class="btn btn-outline-primary w-100 py-3 rounded-4" for="catWhim">
                                <i class="bi bi-controller fs-4 d-block mb-1"></i>
                                <span class="fw-bold">Capricho</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="expenseDesc" class="form-label text-muted small fw-bold mb-2">DESCRIPCIÓN <span class="fw-normal text-muted-50">(Opcional)</span></label>
                    <input type="text" class="form-control form-control-lg bg-light border-0" id="expenseDesc" name="Description" placeholder="Ej. Compra en el súper..." autocomplete="off">
                </div>

                <div class="d-grid mt-2">
                    <button type="submit" id="btnSaveExpense" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm">
                        <span class="btn-text">Añadir gasto</span>
                        <span class="spinner-border spinner-border-sm d-none ms-2" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/expense-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
