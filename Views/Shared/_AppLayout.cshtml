<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PocketFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="theme-color" id="theme-color-meta" content="#ffffff" />
    <script>
        (function() {
            var theme = localStorage.getItem('pocketflow-theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            
            var metaThemeColor = document.getElementById('theme-color-meta');
            if (theme === 'dark') {
                metaThemeColor.setAttribute('content', '#101010');
            } else if (theme === 'midnight') {
                metaThemeColor.setAttribute('content', '#060d18');
            } else {
                metaThemeColor.setAttribute('content', '#f8f9fa'); // light background
            }
        })();
    </script>
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" />
    <link href="~/css/toast.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? "Usuario";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var avatarUrl = User.FindFirst("avatar_url")?.Value;
}
<body class="pb-5 pb-md-0">
    <div class="d-flex flex-column flex-md-row min-vh-100">
        <!-- Sidebar para Escritorio -->
        <nav class="sidebar bg-white border-end d-none d-md-flex flex-column p-3">
            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <span class="fs-4 fw-bold text-primary">PocketFlow</span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(currentCtrl == "Dashboard" ? "active bg-light text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "Dashboard" ? "page" : null)">
                        <i class="bi bi-house-door-fill me-2"></i> Inicio
                    </a>
                </li>
                <li>
                    <a asp-controller="Pocket" asp-action="Index" class="nav-link @(currentCtrl == "Pocket" ? "active bg-light text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "Pocket" ? "page" : null)">
                        <i class="bi bi-wallet2 me-2"></i> Bolsillo
                    </a>
                </li>
                <li>
                    <a asp-controller="PiggyBanks" asp-action="Index" class="nav-link @(currentCtrl == "PiggyBanks" ? "active bg-light text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "PiggyBanks" ? "page" : null)">
                        <i class="bi bi-piggy-bank me-2"></i> Huchas
                    </a>
                </li>
                <li>
                    <a asp-controller="History" asp-action="Index" class="nav-link @(currentCtrl == "History" ? "active bg-light text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "History" ? "page" : null)">
                        <i class="bi bi-clock-history me-2"></i> Historial
                    </a>
                </li>
            </ul>
            <hr>
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle" id="dropdownUser2" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="Avatar" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle fs-4 me-2"></i>
                    }
                    <strong>@userName</strong>
                </a>
                <ul class="dropdown-menu text-small shadow" aria-labelledby="dropdownUser2">
                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">Ajustes</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">Cerrar sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Barra inferior para Móvil -->
        <nav class="mobile-nav bg-white border-top d-md-none fixed-bottom shadow-sm">
            <div class="d-flex justify-content-around p-2">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-center @(currentCtrl == "Dashboard" ? "text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "Dashboard" ? "page" : null)">
                    <i class="bi bi-house-door-fill fs-4 d-block"></i>
                    <span class="small">Inicio</span>
                </a>
                <a asp-controller="Pocket" asp-action="Index" class="nav-link text-center @(currentCtrl == "Pocket" ? "text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "Pocket" ? "page" : null)">
                    <i class="bi bi-wallet2 fs-4 d-block"></i>
                    <span class="small">Bolsillo</span>
                </a>
                <a asp-controller="PiggyBanks" asp-action="Index" class="nav-link text-center @(currentCtrl == "PiggyBanks" ? "text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "PiggyBanks" ? "page" : null)">
                    <i class="bi bi-piggy-bank fs-4 d-block"></i>
                    <span class="small">Huchas</span>
                </a>
                <a asp-controller="History" asp-action="Index" class="nav-link text-center @(currentCtrl == "History" ? "text-primary fw-bold" : "link-dark")" aria-current="@(currentCtrl == "History" ? "page" : null)">
                    <i class="bi bi-clock-history fs-4 d-block"></i>
                    <span class="small">Historial</span>
                </a>
                <a href="#" class="nav-link text-center link-dark" data-bs-toggle="modal" data-bs-target="#profileModal">
                    <i class="bi bi-person fs-4 d-block"></i>
                    <span class="small">Perfil</span>
                </a>
            </div>
        </nav>

        <!-- Modal Perfil Móvil (Bottom-Sheet) -->
        <div class="modal fade profile-bottom-sheet" id="profileModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-bottom m-0">
            <div class="modal-content border-0 rounded-top-4 shadow-lg pb-safe">
              <div class="modal-header border-0 pb-0 justify-content-center pt-3">
                <div class="drag-handle bg-secondary rounded-pill" style="width: 40px; height: 5px; opacity: 0.3;"></div>
              </div>
              <div class="modal-body text-center pt-4 px-4 pb-4">
                <div class="position-relative d-inline-block mb-3">
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="Avatar" class="rounded-circle shadow-sm" style="width: 72px; height: 72px; object-fit: cover;" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle text-secondary" style="font-size: 72px; line-height: 1;"></i>
                    }
                </div>
                <h5 class="fw-bold mb-1">@userName</h5>
                <p class="text-muted small mb-4">@userEmail</p>
                
                <div class="list-group list-group-flush text-start border-0 mb-3">
                    <a asp-controller="Settings" asp-action="Index" class="list-group-item list-group-item-action border-0 d-flex align-items-center py-3 px-2 fw-bold text-dark rounded-3 mb-1">
                        <i class="bi bi-gear-fill text-muted fs-5 me-3"></i> Ajustes
                    </a>
                </div>
                
                <hr class="text-muted opacity-25 mx-2 my-1" />
                
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                    <button type="submit" class="btn btn-light text-danger fw-bold w-100 py-3 rounded-pill">
                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                    </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenido Principal -->
        <main class="flex-grow-1 bg-light main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Botón flotante -->
    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "History")
    {
        <button class="fab btn btn-primary shadow-lg rounded-circle" data-bs-toggle="modal" data-bs-target="#expenseModal" aria-label="Registrar gasto">
            <i class="bi bi-plus-lg fs-4"></i>
        </button>
    }

    <!-- Modal Registro Gasto (Sprint 4) -->
    <div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered align-items-end align-items-md-center m-0 m-md-auto" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg rounded-top-4 rounded-md-3">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold" id="expenseModalTitle">Registrar Gasto</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body pt-3">
            <div id="expenseModalAlert" class="alert alert-danger d-none" role="alert"></div>
            
            <ul class="nav nav-pills nav-fill mb-3 bg-light rounded-pill p-1" id="expenseTypeTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill fw-bold" id="single-tab" data-bs-toggle="pill" data-bs-target="#single-expense" type="button" role="tab">Único</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill fw-bold" id="installment-tab" data-bs-toggle="pill" data-bs-target="#installment-expense" type="button" role="tab">A plazos</button>
                </li>
            </ul>

            <div class="tab-content" id="expenseTypeTabContent">
                <!-- PAGO ÚNICO -->
                <div class="tab-pane fade show active" id="single-expense" role="tabpanel">
                    <form id="expenseForm" asp-controller="Expenses" asp-action="Create" method="post">
                        <input type="hidden" id="expenseId" name="Id" value="" />
                        
                        <div class="mb-4 text-center">
                            <label for="expenseAmount" class="form-label text-muted small fw-bold mb-1">IMPORTE</label>
                            <div class="input-group input-group-lg justify-content-center border-bottom border-2 border-primary pb-2 w-75 mx-auto">
                                <input type="number" min="0.01" step="0.01" class="form-control form-control-plaintext text-center fs-1 fw-bold text-dark p-0" id="expenseAmount" name="Amount" placeholder="0.00" autocomplete="off" required>
                                <span class="input-group-text bg-transparent border-0 fs-3 text-muted p-0 ms-1">€</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold mb-2 d-block">CATEGORÍA</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="Category" id="catLife" value="Life" required>
                                    <label class="btn btn-outline-primary w-100 py-3 rounded-4" for="catLife">
                                        <i class="bi bi-cart3 fs-4 d-block mb-1"></i>
                                        <span class="fw-bold">Vida</span>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="Category" id="catWhim" value="Whim">
                                    <label class="btn btn-outline-primary w-100 py-3 rounded-4" for="catWhim">
                                        <i class="bi bi-controller fs-4 d-block mb-1"></i>
                                        <span class="fw-bold">Capricho</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="expenseDesc" class="form-label text-muted small fw-bold mb-2">DESCRIPCIÓN <span class="fw-normal text-muted-50">(Opcional)</span></label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" id="expenseDesc" name="Description" placeholder="Ej. Compra en el súper..." autocomplete="off">
                        </div>

                        <div class="d-grid mt-2">
                            <button type="submit" id="btnSaveExpense" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm">
                                <span class="btn-text" id="expenseBtnText">Añadir gasto</span>
                                <span class="spinner-border spinner-border-sm d-none ms-2" role="status" aria-hidden="true"></span>
                            </button>
                        </div>
                    </form>
                </div>
                
                <!-- A PLAZOS -->
                <div class="tab-pane fade" id="installment-expense" role="tabpanel">
                    <form id="installmentForm" asp-controller="Installments" asp-action="Create" method="post">
                        
                        <div class="mb-3 text-center">
                            <label for="instTotalAmount" class="form-label text-muted small fw-bold mb-1">COSTE TOTAL</label>
                            <div class="input-group input-group-lg justify-content-center border-bottom border-2 border-primary pb-2 w-75 mx-auto">
                                <input type="number" min="0.01" step="0.01" class="form-control form-control-plaintext text-center fs-2 fw-bold text-dark p-0" id="instTotalAmount" name="TotalAmount" placeholder="0.00" autocomplete="off" required>
                                <span class="input-group-text bg-transparent border-0 fs-4 text-muted p-0 ms-1">€</span>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="instCount" class="form-label text-muted small fw-bold mb-1">Nº CUOTAS</label>
                                <input type="number" class="form-control bg-light border-0 text-center fw-bold" id="instCount" name="InstallmentCount" min="2" max="120" value="3" required>
                            </div>
                            <div class="col-6">
                                <label for="instBaseAmount" class="form-label text-muted small fw-bold mb-1">CUOTA MENSUAL</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0.01" class="form-control bg-light border-0 fw-bold text-end" id="instBaseAmount" name="BaseInstallmentAmount" required>
                                    <span class="input-group-text bg-light border-0 text-muted">€</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold mb-2 d-block">CATEGORÍA</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="Category" id="instCatLife" value="Life" required>
                                    <label class="btn btn-outline-primary w-100 py-2 rounded-4" for="instCatLife">
                                        <i class="bi bi-cart3 fs-5 d-block mb-1"></i>
                                        <span class="fw-bold small">Vida</span>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="Category" id="instCatWhim" value="Whim">
                                    <label class="btn btn-outline-primary w-100 py-2 rounded-4" for="instCatWhim">
                                        <i class="bi bi-controller fs-5 d-block mb-1"></i>
                                        <span class="fw-bold small">Capricho</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="instDesc" class="form-label text-muted small fw-bold mb-1">DESCRIPCIÓN / COMPRA</label>
                            <input type="text" class="form-control bg-light border-0" id="instDesc" name="Description" placeholder="Ej. iPhone 15..." required autocomplete="off">
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="instProvider" class="form-label text-muted small fw-bold mb-1">PROVEEDOR <span class="fw-normal text-muted-50">(Opcional)</span></label>
                                <input type="text" class="form-control bg-light border-0" id="instProvider" name="Provider" placeholder="Ej. Klarna, PayPal..." autocomplete="off">
                            </div>
                            <div class="col-6">
                                <label for="instBillingDay" class="form-label text-muted small fw-bold mb-1">DÍA DE COBRO</label>
                                <input type="number" class="form-control bg-light border-0 text-center" id="instBillingDay" name="BillingDay" min="1" max="31" value="1" required>
                            </div>
                        </div>
                        
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="instFirstPaid" name="FirstInstallmentAlreadyPaid" value="true">
                            <label class="form-check-label small" for="instFirstPaid">La primera cuota se ha cobrado hoy</label>
                        </div>

                        <div class="d-grid mt-2">
                            <button type="submit" id="btnSaveInstallment" class="btn btn-primary rounded-pill py-3 fw-bold shadow-sm">
                                Crear plan a plazos
                            </button>
                        </div>
                    </form>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Eliminar Gasto -->
    <div class="modal fade" id="deleteExpenseModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow">
          <div class="modal-body text-center p-4">
            <i class="bi bi-exclamation-circle text-danger display-4 mb-3 d-block"></i>
            <h5 class="fw-bold mb-2">¿Eliminar gasto?</h5>
            <p class="text-muted mb-4">Esta acción no se puede deshacer y los presupuestos se recalcularán automáticamente.</p>
            
            <div id="deleteExpenseAlert" class="alert alert-danger d-none small mb-3"></div>
            
            <form id="deleteExpenseForm" asp-controller="Expenses" asp-action="Delete" method="post">
                <input type="hidden" id="deleteExpenseId" name="Id" value="" />
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnConfirmDelete" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <span class="btn-text">Sí, eliminar</span>
                        <span class="spinner-border spinner-border-sm d-none ms-2" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/gsap/gsap.min.js"></script>
    <script src="~/js/toast.js"></script>
    <script src="~/js/sounds.js"></script>
    <script src="~/js/animations.js"></script>
    <script src="~/js/expense-modal.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js').catch(err => {
                    console.error('ServiceWorker registration failed: ', err);
                });
            });
        }
    </script>
    @if (TempData["PlaySuccessSound"] != null)
    {
        <script>
            window.addEventListener('load', () => {
                if (window.PocketFlowSound) window.PocketFlowSound.success();
            });
        </script>
    }
    @if (TempData["PlayDeleteSound"] != null)
    {
        <script>
            window.addEventListener('load', () => {
                if (window.PocketFlowSound) window.PocketFlowSound.delete();
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
