@model PocketFlow.ViewModels.MonthlyTransition.RolloverDecisionViewModel
@{
    ViewData["Title"] = "Sobrante del mes";
    Layout = "_MonthlyTransitionLayout";
    ViewData["Step"] = 1;
}

<div class="text-center mb-5">
    <h2 class="fw-bold mb-2">Te han sobrado <span class="text-success">@Model.LeftoverAmount.ToString("C")</span></h2>
    <p class="fs-5 text-muted">¿Qué quieres hacer con ese dinero?</p>
</div>

<form asp-action="Step1_Rollover" method="post" id="rolloverForm">
    <input type="hidden" asp-for="LeftoverAmount" />
    
    <div class="d-flex flex-column gap-3 mb-5">
        
        <!-- Opción 1: Hucha -->
        <label class="wizard-option-card" id="cardPiggy">
            <div class="d-flex gap-3 align-items-center">
                <input class="form-check-input" type="radio" asp-for="DestinationType" value="PiggyBank" id="radioPiggy">
                <div class="flex-grow-1">
                    <span class="d-block fw-bold mb-1 fs-5">Añadir a una hucha</span>
                    <span class="d-block text-muted">Refuerza uno de tus objetivos de ahorro.</span>
                </div>
            </div>
            
            <div id="piggyBankSelector" class="mt-3 ps-5 d-none">
                <select asp-for="DestinationPiggyBankId" class="form-select form-select-lg border-2 shadow-sm" id="piggyBankSelect">
                    <option value="">Elige una hucha...</option>
                    @foreach (var pb in Model.AvailablePiggyBanks)
                    {
                        <option value="@pb.Id">@pb.Icon @pb.Name</option>
                    }
                </select>
                <span asp-validation-for="DestinationPiggyBankId" class="text-danger small mt-1 d-block"></span>
            </div>
        </label>

        <!-- Opción 2: Próximo mes -->
        <label class="wizard-option-card" id="cardNextMonth">
            <div class="d-flex gap-3 align-items-center">
                <input class="form-check-input" type="radio" asp-for="DestinationType" value="NextMonthPocket" id="radioNextMonth">
                <div>
                    <span class="d-block fw-bold mb-1 fs-5">Añadirlo al bolsillo del próximo mes</span>
                    <span class="d-block text-muted">Tendrás más dinero disponible durante el nuevo ciclo.</span>
                </div>
            </div>
        </label>

        <!-- Opción 3: Sin asignar -->
        <label class="wizard-option-card" id="cardUnassigned">
            <div class="d-flex gap-3 align-items-center">
                <input class="form-check-input" type="radio" asp-for="DestinationType" value="Unassigned" id="radioUnassigned">
                <div>
                    <span class="d-block fw-bold mb-1 fs-5">Dejarlo sin asignar</span>
                    <span class="d-block text-muted">El dinero quedará registrado pero no modificará tu nuevo presupuesto.</span>
                </div>
            </div>
        </label>
        
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 py-3 shadow-sm">
            Continuar <i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const allRadios = document.querySelectorAll('input[name="DestinationType"]');
            const allCards = document.querySelectorAll('.wizard-option-card');
            const radioPiggy = document.getElementById('radioPiggy');
            const piggySelector = document.getElementById('piggyBankSelector');
            const piggySelect = document.getElementById('piggyBankSelect');

            function updateUI() {
                // Update cards selection
                allCards.forEach(card => {
                    const radio = card.querySelector('input[type="radio"]');
                    if (radio && radio.checked) {
                        card.classList.add('selected');
                    } else {
                        card.classList.remove('selected');
                    }
                });

                // Show/hide piggy bank selector
                if (radioPiggy.checked) {
                    piggySelector.classList.remove('d-none');
                    piggySelect.disabled = false;
                } else {
                    piggySelector.classList.add('d-none');
                    piggySelect.disabled = true;
                    piggySelect.value = '';
                }
            }

            allRadios.forEach(r => r.addEventListener('change', updateUI));
            
            // Allow clicking anywhere on the card to select it
            allCards.forEach(card => {
                card.addEventListener('click', function(e) {
                    if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT' && e.target.tagName !== 'OPTION') {
                        const radio = this.querySelector('input[type="radio"]');
                        if (radio && !radio.checked) {
                            radio.checked = true;
                            // manually trigger change event
                            const event = new Event('change');
                            radio.dispatchEvent(event);
                        }
                    }
                });
            });

            updateUI(); // Initial state
        });
    </script>
}
