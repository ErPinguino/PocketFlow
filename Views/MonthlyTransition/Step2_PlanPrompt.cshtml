@{
    ViewData["Title"] = "Tu próximo plan";
    Layout = "_MonthlyTransitionLayout";
    ViewData["Step"] = 2;
}

<div class="text-center mb-5">
    <h2 class="fw-bold mb-2">¿Quieres mantener tu plan?</h2>
    <p class="fs-5 text-muted">Puedes empezar el nuevo mes exactamente igual o revisar tus cantidades.</p>
</div>

<form asp-action="Step2_PlanPrompt" method="post">
    <div class="row g-4 mb-5">
        
        <!-- Mantener -->
        <div class="col-12 col-md-6">
            <div class="wizard-option-card h-100 d-flex flex-column" onclick="document.getElementById('btnKeep').click()">
                <div class="text-center mb-4">
                    <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-arrow-repeat fs-1 text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Mantener mi plan</h4>
                </div>
                
                <ul class="list-unstyled text-muted flex-grow-1 ps-3">
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Conserva ingreso</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Gastos fijos</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Aportaciones a huchas</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Presupuesto Vida</li>
                    <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Presupuesto Caprichos</li>
                </ul>

                <button type="submit" name="decision" value="keep" id="btnKeep" class="btn btn-primary w-100 rounded-pill py-3 fw-bold mt-4 shadow-sm">
                    Mantener plan
                </button>
            </div>
        </div>

        <!-- Revisar -->
        <div class="col-12 col-md-6">
            <div class="wizard-option-card h-100 d-flex flex-column" onclick="document.getElementById('btnReview').click()">
                <div class="text-center mb-4">
                    <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-sliders fs-1 text-secondary"></i>
                    </div>
                    <h4 class="fw-bold">Revisar mi plan</h4>
                </div>
                
                <ul class="list-unstyled text-muted flex-grow-1 ps-3">
                    <li class="mb-2"><i class="bi bi-pencil me-2"></i> Modificar ingreso</li>
                    <li class="mb-2"><i class="bi bi-pencil me-2"></i> Ajustar gastos fijos</li>
                    <li class="mb-2"><i class="bi bi-pencil me-2"></i> Editar aportaciones a huchas</li>
                    <li class="mb-2"><i class="bi bi-pencil me-2"></i> Cambiar presupuesto Vida</li>
                    <li class="mb-2"><i class="bi bi-pencil me-2"></i> Cambiar presupuesto Caprichos</li>
                </ul>

                <button type="submit" name="decision" value="review" id="btnReview" class="btn btn-outline-secondary w-100 rounded-pill py-3 fw-bold mt-4">
                    Revisar plan
                </button>
            </div>
        </div>

    </div>
    
    <div class="d-flex justify-content-start">
        <a asp-action="Start" class="btn btn-link text-muted text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</form>
